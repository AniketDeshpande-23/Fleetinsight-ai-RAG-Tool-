# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: ollama | claude | openai
LLM_PROVIDER=ollama

# Ollama (default — local, free)
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

# Claude API (cloud fallback)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI (cloud fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Email Connector ────────────────────────────────────────────────────────────
# Options: smtp | graph_api
EMAIL_PROVIDER=smtp

# SMTP (Gmail, Outlook, any provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@email.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your@email.com

# Microsoft Graph API (Outlook — requires Azure app registration)
# https://learn.microsoft.com/en-us/graph/auth-register-app-v2
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
GRAPH_USER_EMAIL=

# ── Alert Recipients ───────────────────────────────────────────────────────────
MAINTENANCE_ALERT_EMAIL=maintenance-manager@company.com
SAFETY_ALERT_EMAIL=safety-officer@company.com
DELIVERY_ALERT_EMAIL=account-manager@company.com

# ── Risk Thresholds ────────────────────────────────────────────────────────────
MAINTENANCE_HIGH_RISK_THRESHOLD=0.65
SAFETY_INCIDENT_WINDOW_DAYS=30
SAFETY_LICENSE_WARNING_DAYS=30
DELIVERY_SLA_MIN_RATE=0.85

# ── Paths (relative to backend/) ──────────────────────────────────────────────
VECTOR_PATH=../vector_store
DATA_PATH=../data
